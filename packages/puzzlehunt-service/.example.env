# Copy these settings into .env at the repository root.
# Use the credentials for your local PostgreSQL server.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/belle_puzzles
HOST=127.0.0.1
# PORT=3001
PUZZLEHUNT_ALLOWED_ORIGINS=http://localhost:9000

# Optional trusted-service access. Supply both credentials together.
# PUZZLEHUNT_SERVICE_TOKEN=<at-least-32-non-whitespace-characters>
# DISCORD_TOKEN=<your-discord-bot-token>
