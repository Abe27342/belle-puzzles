	},
	"devDependencies": {
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.14",
		"@types/node": "^16.9.0",
		"@types/pg": "^8.15.5",
		"prettier": "^2.7.1",
		"typescript": "^5.2.2",
		"vitest": "^4.0.16"
	}
