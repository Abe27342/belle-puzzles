{
	"name": "@belle-puzzles/puzzlehunt-service",
	"version": "0.0.1",
	"private": true,
	"description": "Authoritative HTTP service for puzzlehunt documents",
	"type": "module",
	"exports": {
		"./app": {
			"types": "./dist/app.d.ts",
			"default": "./dist/app.js"
		}
	},
