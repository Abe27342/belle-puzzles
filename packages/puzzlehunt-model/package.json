{
	"name": "@belle-puzzles/puzzlehunt-model",
	"version": "0.0.1",
	"description": "Puzzlehunt model for belle bot and website",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./document": {
			"types": "./dist/document.d.ts",
			"default": "./dist/document.js"
		},
		"./postgres": {
			"types": "./dist/postgres/index.d.ts",
			"default": "./dist/postgres/index.js"
		},
		"./model": {
			"types": "./dist/model/index.d.ts",
			"default": "./dist/model/index.js"
		},
		"./fluid": {
			"types": "./dist/fluid/index.d.ts",
			"default": "./dist/fluid/index.js"
		},
		"./postgres/schema.sql": "./src/postgres/schema.sql"
	},
	"typesVersions": {
		"*": {
			"document": ["dist/document.d.ts"],
			"model": ["dist/model/index.d.ts"],
			"fluid": ["dist/fluid/index.d.ts"],
			"postgres": ["dist/postgres/index.d.ts"]
		}
	},
	"type": "module",
	"engines": {
		"node": ">=20.15.0"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc",
		"format": "prettier --write src",
		"start:localserver": "azure-local-service > azure-local-service.log 2>&1",
		"test": "node scripts/test-local.mjs",
		"test:coverage": "node scripts/test-local.mjs --coverage",
		"test:run": "vitest run",
		"test:contract": "node scripts/test-local.mjs model.spec.ts",
		"test:coverage:run": "vitest run --coverage",
		"start": "node ./dist/index.js"
	},
	"dependencies": {
		"@fluid-experimental/tree": "^1.2.7",
		"@fluidframework/azure-client": "^1.0.1",
		"@fluidframework/common-definitions": "^0.20.1",
		"@fluidframework/common-utils": "^0.32.2",
		"@fluidframework/container-loader": "^1.3.5",
		"@fluidframework/fluid-static": "^1.3.5",
		"fluid-framework": "^1.3.3"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.14",
		"@fluidframework/azure-local-service": "^1.1.1",
		"@fluidframework/test-client-utils": "^1.3.5",
		"@types/debug": "^4.1.5",
		"@types/node": "^16.9.0",
		"@types/pg": "^8.15.5",
		"embedded-postgres": "18.6.0-beta.19",
		"pg": "^8.23.1",
		"prettier": "^2.7.1",
		"start-server-and-test": "^1.11.7",
		"typescript": "^5.2.2",
		"vite": "^7.2.7",
		"vitest": "^4.0.16"
	},
	"author": "Abram Sanderson",
	"license": "MIT"
}
